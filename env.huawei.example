# Copy to .env on the cloud server and fill in the account locally.
# Do not send passwords or TOTP secrets in chat.
ACCOUNT_1_EMAIL=
# Optional for accounts that support password sign-in.
#ACCOUNT_1_PASSWORD=
#ACCOUNT_1_TOTP_SECRET=
ACCOUNT_1_GEO_LOCALE=auto
ACCOUNT_1_LANG_CODE=zh-CN
IMAGE_TAG=4.3.2-huawei-cloud

# Enable after setting credentials and verifying cloud connectivity.
CONFIG_TELEGRAM_ENABLED=false
CONFIG_TELEGRAM_SUMMARY_ONLY=true
#CONFIG_TELEGRAM_BOTTOKEN=
#CONFIG_TELEGRAM_CHATID=
# Optional dedicated Telegram proxy; it does not proxy Microsoft traffic.
#CONFIG_TELEGRAM_PROXY_URL=socks5://proxy-host:1080

# Optional HTTPS relay; use instead of bot credentials/proxy in the cloud.
#CONFIG_TELEGRAM_RELAY_URL=https://your-worker-domain/notify
#CONFIG_TELEGRAM_RELAY_TOKEN=

# Optional source label; omit when the Worker already adds it.
#CONFIG_TELEGRAM_SOURCE_LABEL=
